{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Quack Kitchen (Linux Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "linux-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Quack Kitchen (Linux Debug)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "linux-debug", "--parallel"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure Quack Kitchen (Linux Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Test Quack Kitchen (Linux Debug)",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "Build/linux-debug", "--output-on-failure"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build Quack Kitchen (Linux Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
