#include <windows.h>

#define IDI_QUACK_KITCHEN 101
IDI_QUACK_KITCHEN ICON "@QUACK_KITCHEN_ICON_RC_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DigiPen Institute of Technology\0"
            VALUE "FileDescription", "Quack Kitchen\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "Quack Kitchen\0"
            VALUE "LegalCopyright", "Copyright (C) 2024 DigiPen Institute of Technology\0"
            VALUE "OriginalFilename", "Quack Kitchen.exe\0"
            VALUE "ProductName", "Quack Kitchen\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
